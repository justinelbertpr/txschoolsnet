# Claude Code loop state
.loop-state/

# NOTE: data/raw/ is deliberately NOT ignored. The dated TEA snapshots (~4.5 MB/year
# gzipped) are committed as the site's provenance chain — every published claim traces
# back to the exact bytes TEA served on a given date.

# Built artifacts — regenerable from data/raw/ by the build step
*.duckdb
*.duckdb.wal
*.sqlite
*.db

# Build outputs — regenerated by `npm run site`
build/

# Generated dashboard payload — regenerated by `npm run export`. Other
# site/ files (index.html, 404.html, style.css, _headers) are hand-authored
# and committed, so this is scoped to site/data/ rather than a blanket site/.
site/data/

# Generated entity pages and sitemap — regenerated by `npm run prerender`.
site/district/
site/campus/
site/region/
site/county/
site/districts/
site/sitemap.xml
site/about.html
site/download.html
site/404.html
site/index.html

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
dist/
.wrangler/
.dev.vars

# OS
.DS_Store
