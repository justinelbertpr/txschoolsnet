# site/data/ holds two kinds of file: content-hashed ones whose name changes
# when the content does (payload-<hash>.json), and stable-named ones a build
# simply overwrites in place (the bulk CSVs, the per-district CSV/JSON, the
# per-district pin bundles, search-index.json and district-locator.json). A
# year-long immutable cache is only honest for the first kind, so the rules
# below are scoped per file rather than one blanket
# /data/* rule.
#
# This also has to be done as several non-overlapping patterns rather than a
# narrower rule layered on top of /data/*: Cloudflare's _headers format does
# not let a more specific rule override a broader one — when two rules both
# match a request, their headers are combined and a header set by both is
# joined with a comma (developers.cloudflare.com/workers/static-assets/headers/).
# A second, shorter-lived Cache-Control on top of the immutable one would not
# replace it; it would ship both values in one header.

/data/entity/*
  Cache-Control: public, max-age=31536000, immutable

/data/payload-*.json
  Cache-Control: public, max-age=31536000, immutable

/data/entities.csv
  Cache-Control: public, max-age=31536000, immutable

/data/ratings.csv
  Cache-Control: public, max-age=31536000, immutable

/data/profile.csv
  Cache-Control: public, max-age=31536000, immutable

# Rebuilt under the same name every run (it is not content-hashed), so a
# year-long cache would leave a returning visitor searching a stale index —
# potentially one missing or mis-slugging schools the current build renders
# correctly. An hour is long enough to matter for CDN load, short enough that
# a rebuild is never stale for long.
/data/search-index.json
  Cache-Control: public, max-age=3600

# The Census GEOID-to-local-profile bridge is rebuilt under this stable name
# with every boundary/data refresh. Keep it aligned with the current site rather
# than letting a previous snapshot remain immutable in a returning browser.
/data/district-locator.json
  Cache-Control: public, max-age=3600

# One stable filename per district, rebuilt with every snapshot. These are
# lazy-loaded only after a reader pins an entity, and an hour keeps repeat pins
# cheap without allowing a previous snapshot to persist for a year.
/data/pins/*
  Cache-Control: public, max-age=3600

# ---------------------------------------------------------------------------
# SECURITY HEADERS — every response, via /*, which Cloudflare's format treats
# as matching everything. No header name below collides with a Cache-Control
# rule above, so the "headers merge, comma-joined on collision" rule noted at
# the top of this file never triggers here: /data/* responses get both their
# specific Cache-Control AND everything below, cleanly.
#
# CSP is deny-by-default (default-src 'none') with narrow allow-lists rather
# than one broad relaxation, because this is a 100% static, server-less site:
# every resource it ever loads is knowable ahead of time by reading the
# rendered HTML, so "list exactly what's really there" costs nothing and
# "allow broad categories just in case" would buy nothing.
#
#   script-src   'self' covers the same-origin module/external scripts
#                (/app.js, /search.js, /address.js, /rankings.js — all <script src=...>,
#                loaded from this origin only). Every *inline* <script> the
#                build ever emits is one of three byte-identical constants —
#                THEME_INIT_SCRIPT and TRUSTED_TYPES_INIT_SCRIPT in
#                src/render/shell.js (on every page), and
#                RANKINGS_GROUP_FILTER_JS in src/render/rankings-page.js
#                (site/rankings.html only) — so each gets its own
#                'sha256-...' source instead of 'unsafe-inline'. Verified
#                against a full `npm run site` build: exactly these three
#                hashes occur across all 9,531 rendered pages, nothing else
#                does. (A fourth, NAV_INIT_SCRIPT, was removed with the
#                mobile nav disclosure it closed — see the MASTHEAD note in
#                site/style.css for why that mechanism is gone.)
#                `<script type="application/json" data-cohorts|data-own|
#                data-trajectory|data-pin-source|data-rankings-lookups>`
#                data-island tags are inert JSON, never executed, and need no
#                script-src entry at all — only the three above actually run
#                as script.
#
#                IMPORTANT — these hashes are tied to exact bytes: editing
#                any of the three constants named above changes its rendered
#                <script> content and therefore its hash, silently breaking
#                that inline script under this CSP (the browser drops it,
#                no console-visible failure beyond a CSP violation report)
#                until the hash below is recomputed and replaced. To
#                recompute: `npm run site`, then for the changed script's
#                exact <script>...</script> body as it appears in the built
#                HTML (not the JS source constant string — whitespace or
#                quoting can differ), `openssl dgst -sha256 -binary | base64`
#                (or Node's crypto.createHash('sha256')...digest('base64')).
#
#                static.cloudflareinsights.com is Cloudflare's own Web
#                Analytics/RUM beacon (beacon.min.js) — injected at the edge
#                by Cloudflare's zone settings (Speed > Observatory /
#                Analytics), not by anything in this repo's source (grepped:
#                no reference anywhere in src/ or site/). Allow-listed here,
#                under both script-src and connect-src below, purely so a
#                strict CSP does not silently break Cloudflare's own
#                instrumentation; remove both if that zone setting is ever
#                turned off.
#
#                geocoding.geo.census.gov is restricted to the one documented
#                geographies/onelineaddress endpoint the address finder uses.
#                Census does not support CORS and explicitly documents JSONP
#                for browser clients; shell.js's Trusted Types policy further
#                requires the fixed benchmark, vintage, district layer and this
#                site's callback pattern before accepting the dynamic URL.
#
#   style-src    'unsafe-inline' is deliberate, not an oversight: the one
#                static <style> block (src/render/search.js's searchAssets,
#                byte-identical on every page) could be hashed, but every
#                chart (src/render/charts.js) also writes a per-data-point
#                `style="--m:...;background:..."` attribute — 192,000+
#                occurrences across the built site, a different value at
#                nearly every one, because the value IS the data (a bar's
#                length, a dot's position). There is no finite hash list for
#                that, and CSS injection is not the same risk class as script
#                injection (no code execution), so 'unsafe-inline' here does
#                not weather the "avoid unsafe-inline" bar that script-src
#                has to clear. 'self' still covers the external stylesheet.
#
#   trusted-types / require-trusted-types-for — enforced, not just declared,
#                because TRUSTED_TYPES_INIT_SCRIPT (src/render/shell.js)
#                installs a policy literally named "default" before any other
#                script runs. That name is what lets the platform keep
#                honouring the plain-string .innerHTML writes already in
#                site/app.js and site/rankings.js (chart redraws, the
#                rankings tool's results table) without either file being
#                rewritten — see the comment on TRUSTED_TYPES_INIT_SCRIPT
#                itself for why that is the correct trade-off here, not a
#                loophole. Restricting the directive to exactly that one name
#                is what stops any other script — vendored, injected, or
#                otherwise — from registering a competing "default" policy
#                and intercepting those sinks first.
#
# frame-ancestors 'none' is the modern, CSP-based clickjacking control;
# X-Frame-Options: DENY sits alongside it only for browsers old enough to
# ignore frame-ancestors. Strict-Transport-Security is safe to set
# unconditionally — wrangler.jsonc's custom_domain is already HTTPS-only, so
# there is no plain-HTTP origin this could ever lock a reader out of.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://www.googletagmanager.com https://geocoding.geo.census.gov/geocoder/geographies/onelineaddress 'sha256-wBdtWdXsHnAU2DdByySW4LlXFAScrBvmBgkXtydwJdg=' 'sha256-1T7wxy1lJpxN+V5V2NyExtYgm/RlXONHoqaOmI6zQC4=' 'sha256-b3FhZxwL6eGhRO/NVQ9RUwptDN+GB1ks5O5u1LU8FSw=' 'sha256-PiJjrtl4vqQqu+0o5I9S5RQz6NEFIbhAU7prdNQpiVE=' https://static.cloudflareinsights.com https://*.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://www.googletagmanager.com; font-src 'self'; connect-src 'self' https://static.cloudflareinsights.com https://*.cloudflareinsights.com https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; require-trusted-types-for 'script'; trusted-types default; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  X-Frame-Options: DENY
